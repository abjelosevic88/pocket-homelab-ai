# Pocket AI runs on the host (not in a container) as the user whose `claude`
# and `codex` logins it drives. See docs/configuration.md.
HOST=127.0.0.1
PORT=8195
TZ=Europe/Berlin
BASE_URL=https://ai.example.com
SECURE_COOKIES=true
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# Folders agents may start in (comma-separated, ~ allowed). Default: your home.
# ROOTS=~,/srv
# NOTIFY_URL=http://127.0.0.1:8000/notify/ai
# CORE_URL=http://127.0.0.1:8179
# CORE_REGISTRATION_KEY=
